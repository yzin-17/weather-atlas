{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM", "DOM.Iterable", "DOM.AsyncIterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": false,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "types.d.ts",
    "next.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "test/**/*.ts",
    "tests/**/*.ts",
    ".next/types/**/*.ts",
    ".next-typescript/types/**/*.ts",
    ".next-typescript/dev/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-prompt-check/types/**/*.ts",
    ".next-prompt-check/dev/types/**/*.ts",
    ".next-single-city/types/**/*.ts",
    ".next-single-city/dev/types/**/*.ts",
    ".next-type-audit/types/**/*.ts",
    ".next-type-audit/dev/types/**/*.ts",
    ".next-ai-sdk/types/**/*.ts",
    ".next-ai-sdk/dev/types/**/*.ts",
    ".next-type-audit-final/types/**/*.ts",
    ".next-type-audit-final/dev/types/**/*.ts",
    ".next-map-clean/types/**/*.ts",
    ".next-map-clean/dev/types/**/*.ts",
    ".next-selection-loading/types/**/*.ts",
    ".next-selection-loading/dev/types/**/*.ts",
    ".next-selection-loading-final/types/**/*.ts",
    ".next-selection-loading-final/dev/types/**/*.ts",
    ".next-selection-loading-release/types/**/*.ts",
    ".next-selection-loading-release/dev/types/**/*.ts",
    ".next-map-entry-cleanup/types/**/*.ts",
    ".next-map-entry-cleanup/dev/types/**/*.ts",
    ".next-default-city-seo/types/**/*.ts",
    ".next-default-city-seo/dev/types/**/*.ts",
    ".next-shenzhen-default/types/**/*.ts",
    ".next-shenzhen-default/dev/types/**/*.ts",
    ".next-location-grant/types/**/*.ts",
    ".next-location-grant/dev/types/**/*.ts",
    ".next-reverse-recovery/types/**/*.ts",
    ".next-reverse-recovery/dev/types/**/*.ts",
    ".next-chengdu-location/types/**/*.ts",
    ".next-chengdu-location/dev/types/**/*.ts",
    ".next-web-cache-refresh/types/**/*.ts",
    ".next-web-cache-refresh/dev/types/**/*.ts",
    ".next-ai-failure-input/types/**/*.ts",
    ".next-ai-failure-input/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
