{
  "name": "weather-atlas-web",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env.ai.local node_modules/next/dist/bin/next dev",
    "dev:https": "node --env-file-if-exists=../.env.https.local ../qa/local-https.ts",
    "format": "npm --prefix .. run format",
    "format:check": "npm --prefix .. run format:check",
    "build": "next build",
    "start": "node --env-file-if-exists=../.env.ai.local node_modules/next/dist/bin/next start",
    "warm": "node --env-file-if-exists=.env.local ../qa/prewarm.ts",
    "rum:report": "node --env-file-if-exists=.env.local ../qa/rum-report.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.177",
    "ai": "7.0.173",
    "leaflet": "^1.9.4",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
