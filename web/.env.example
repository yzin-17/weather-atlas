# 真实天气默认值；演示请显式改为 demo，页面会标注且禁止索引。
WEATHER_MODE=live
# 生产构建／启动必须配置站点根地址；公开部署使用正式 HTTPS 域名。
# 不支持子路径、凭据、查询或片段；本次使用 3300，保留已有 3000 服务。
SITE_URL=http://localhost:3300
# 多实例必须使用相同绝对目录或共享挂载，应用用户需要写权限。
WEATHER_CACHE_DIR=../.weather-cache
WEATHER_TRACE=0
# 仅服务器保存；无 Key 时为规则预览，不会付费调用。
# 本机凭据建议放在根目录 .env.ai.local，npm run dev/start 和本地 HTTPS 会读取。
# .env.ai.local 不提交、不进入源码包；显式空 AI_API_KEY 可用于独立规则模式验收。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# 已验证的低成本意图模型；Luna 请求使用 reasoning_effort=none。
AI_MODEL=gpt-6-luna
# 比较意图使用严格 JSON Schema；自定义模型端点必须支持该输出格式。
# 正式供图需要四套已发布样式与允许分发、限制来源的公开令牌。
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAP_STYLE_ZH_HANS=
NEXT_PUBLIC_MAP_STYLE_ZH_HANT=
NEXT_PUBLIC_MAP_STYLE_EN=
NEXT_PUBLIC_MAP_STYLE_KO=
# 历史测试生成器仅供复查旧证据；正常服务保持关闭。
WEATHER_TEST_TILES=0
# 默认 /api/map-tiles 转发真实 OSM；无商业地图 Key 也可运行。
# 瓦片缓存位于 WEATHER_CACHE_DIR/map-tiles，遵守上游缓存头，默认 7 天。
# 受控访问改为 local-validation，与真实用户分开。
RUM_ENVIRONMENT=production
# 以下仅用于受控上游和 A/B 验证，正式环境保持默认。
WEATHER_FORECAST_URL=
# 城市标签反查；留空使用 Photon 公共端点，可替换为自建兼容服务。
# 名称查询独立缓存／限速，失败不阻塞原坐标天气。
WEATHER_REVERSE_URL=
NEXT_PUBLIC_MAP_EAGER=0
# 正常构建保留 MAP_EAGER=0；其他城市有限预取和弹窗意图预热无需环境开关。
# 完整路由缓存 60 秒配置在 next.config.ts；天气新鲜／旧数据窗口为 15 分钟／3 小时。
# 本机 Node 26 联网验收在启动进程前设置 NODE_USE_ENV_PROXY=1、HTTPS_PROXY
# 与 NO_PROXY；具体代理属于机器配置，不把地址或凭据写入本模板。
