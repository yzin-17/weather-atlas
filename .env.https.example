# 复制为 .env.https.local；项目根目录或 web/ 下均可执行 npm run dev:https。
# 未指定 LOCAL_HTTPS_IP 时自动识别当前局域网 IPv4，证书需包含该地址。
LOCAL_HTTPS_PORT=3443
LOCAL_HTTPS_BACKEND_PORT=3343
LOCAL_HTTPS_SETUP_PORT=3444

# 默认直连；需要代理时，仅在不提交的 .env.https.local 中设置地址并启用。
NODE_USE_ENV_PROXY=0
HTTP_PROXY=
HTTPS_PROXY=
# HTTPS 入口与本机后端之间不走代理。
NO_PROXY=localhost,127.0.0.1,::1
